"""
HD wallet primitives.

This module intentionally does not expose private keys or implement
network-specific signing. Use a vetted BIP-39/BIP-32 implementation
such as bip_utils for production key derivation.
"""

from dataclasses import dataclass
from typing import Optional


@dataclass(frozen=True)
class WalletAddress:
    network: str
    account: int
    change: int
    index: int
    address: str


class HDWalletService:
    """High-level interface for HD wallet operations."""

    def __init__(self, network: str = "ethereum"):
        self.network = network

    def generate_mnemonic(self, strength: int = 256) -> str:
        """
        Generate a BIP-39 mnemonic.

        Install/use bip_utils in the production implementation.
        """
        try:
            from bip_utils import Bip39MnemonicGenerator, Bip39WordsNum
        except ImportError as exc:
            raise RuntimeError(
                "Install bip_utils before generating a mnemonic."
            ) from exc

        words = {
            128: Bip39WordsNum.WORDS_NUM_12,
            160: Bip39WordsNum.WORDS_NUM_15,
            192: Bip39WordsNum.WORDS_NUM_18,
            224: Bip39WordsNum.WORDS_NUM_21,
            256: Bip39WordsNum.WORDS_NUM_24,
        }.get(strength)

        if words is None:
            raise ValueError("strength must be one of 128, 160, 192, 224, 256")

        return str(Bip39MnemonicGenerator().FromWordsNumber(words))

    def derive_address(
        self,
        mnemonic: str,
        account: int = 0,
        change: int = 0,
        index: int = 0,
        passphrase: str = "",
    ) -> WalletAddress:
        """
        Derive a public address.

        Network-specific derivation should be implemented explicitly
        rather than silently guessing a coin/path.
        """
        raise NotImplementedError(
            "Implement explicit network derivation using a vetted "
            "BIP-39/BIP-32/BIP-44 library."
        )
