    "apps/usb_manager/transport.py": r'''
from dataclasses import dataclass
from pathlib import Path
import hashlib


@dataclass(frozen=True)
class TransferPackage:
    filename: str
    sha256: str
    data: bytes


class USBTransport:
    """
    Controlled transfer boundary between online and offline systems.

    Always hash and validate the exact bytes being transferred.
    """

    def package(self, filename: str, data: bytes) -> TransferPackage:
        digest = hashlib.sha256(data).hexdigest()

        return TransferPackage(
            filename=filename,
            sha256=digest,
            data=data,
        )

    def verify(self, package: TransferPackage) -> bool:
        actual = hashlib.sha256(package.data).hexdigest()
        return actual == package.sha256

    def write(self, mount_point: Path, package: TransferPackage) -> Path:
        if not self.verify(package):
            raise ValueError("Transfer package failed SHA-256 verification.")

        target = Path(mount_point) / package.filename
        target.write_bytes(package.data)
        return target
''',

