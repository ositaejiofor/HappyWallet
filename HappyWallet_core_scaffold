"""
Vault encryption helpers.

Install:
    pip install cryptography

The vault format uses:
    Scrypt password KDF -> AES-256-GCM authenticated encryption
"""

import base64
import os
from dataclasses import dataclass

from cryptography.hazmat.primitives.ciphers.aead import AESGCM
from cryptography.hazmat.primitives.kdf.scrypt import Scrypt


@dataclass(frozen=True)
class EncryptedBlob:
    salt: bytes
    nonce: bytes
    ciphertext: bytes

    def as_dict(self) -> dict[str, str]:
        return {
            "salt": base64.b64encode(self.salt).decode("ascii"),
            "nonce": base64.b64encode(self.nonce).decode("ascii"),
            "ciphertext": base64.b64encode(self.ciphertext).decode("ascii"),
        }


class EncryptionService:
    """Password-based authenticated encryption."""

    SALT_SIZE = 16
    NONCE_SIZE = 12
    KEY_SIZE = 32

    def derive_key(self, password: str, salt: bytes) -> bytes:
        if not password:
            raise ValueError("Password cannot be empty.")

        kdf = Scrypt(
            salt=salt,
            length=self.KEY_SIZE,
            n=2**15,
            r=8,
            p=1,
        )
        return kdf.derive(password.encode("utf-8"))

    def encrypt(self, plaintext: bytes, password: str) -> EncryptedBlob:
        salt = os.urandom(self.SALT_SIZE)
        nonce = os.urandom(self.NONCE_SIZE)
        key = self.derive_key(password, salt)

        ciphertext = AESGCM(key).encrypt(
            nonce,
            plaintext,
            None,
        )

        return EncryptedBlob(salt, nonce, ciphertext)

    def decrypt(self, blob: EncryptedBlob, password: str) -> bytes:
        key = self.derive_key(password, blob.salt)

        return AESGCM(key).decrypt(
            blob.nonce,
            blob.ciphertext,
            None,
        )
''',

    "apps/security/key_store.py": r'''
from dataclasses import dataclass
from pathlib import Path

from .encryption import EncryptedBlob, EncryptionService


@dataclass
class KeyStore:
    """
    Encrypted vault storage.

    This class deliberately stores encrypted bytes only.
    """

    path: Path
    encryption: EncryptionService

    def save(self, secret: bytes, password: str) -> None:
        blob = self.encryption.encrypt(secret, password)

        payload = (
            b"HWV1\n"
            + blob.salt
            + blob.nonce
            + blob.ciphertext
        )

        self.path.parent.mkdir(parents=True, exist_ok=True)
        self.path.write_bytes(payload)

    def load(self, password: str) -> bytes:
        payload = self.path.read_bytes()

        if not payload.startswith(b"HWV1\n"):
            raise ValueError("Unsupported or corrupted wallet vault.")

        payload = payload[5:]

        salt = payload[:16]
        nonce = payload[16:28]
        ciphertext = payload[28:]

        blob = EncryptedBlob(
            salt=salt,
            nonce=nonce,
            ciphertext=ciphertext,
        )

        return self.encryption.decrypt(blob, password)
''',

