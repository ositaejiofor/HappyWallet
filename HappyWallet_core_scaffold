from dataclasses import dataclass


@dataclass(frozen=True)
class SecurityPolicy:
    require_offline_signing: bool = True
    allow_private_key_export: bool = False
    allow_seed_export: bool = False
    require_transaction_confirmation: bool = True
    require_address_verification: bool = True
    lock_after_seconds: int = 300


class SecurityPolicyService:
    """Central security-policy checks."""

    def __init__(self, policy: SecurityPolicy | None = None):
        self.policy = policy or SecurityPolicy()

    def assert_signing_allowed(self, online: bool) -> None:
        if self.policy.require_offline_signing and online:
            raise PermissionError(
                "Signing is disabled while the wallet is online."
            )

    def assert_export_allowed(self, export_type: str) -> None:
        if export_type == "seed" and not self.policy.allow_seed_export:
            raise PermissionError("Seed export is disabled by policy.")

        if (
            export_type == "private_key"
            and not self.policy.allow_private_key_export
        ):
            raise PermissionError(
                "Private-key export is disabled by policy."
            )
''',

