from pathlib import Path

from apps.security.encryption import EncryptionService
from apps.security.key_store import KeyStore


class USBVault:
    """Encrypted wallet-vault facade for a removable device."""

    VAULT_FILENAME = "happywallet.vault"

    def __init__(self, mount_point: Path):
        self.mount_point = Path(mount_point)
        self.store = KeyStore(
            self.mount_point / self.VAULT_FILENAME,
            EncryptionService(),
        )

    def initialize(self, secret: bytes, password: str) -> None:
        self.store.save(secret, password)

    def unlock(self, password: str) -> bytes:
        return self.store.load(password)

    def exists(self) -> bool:
        return self.store.path.exists()
